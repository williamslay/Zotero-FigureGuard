{
  "name": "zotero-figure-guard",
  "version": "0.8.0",
  "private": true,
  "description": "Zotero Figure Guard — keeps figures in their original colours inside the dark-theme PDF reader",
  "type": "module",
  "license": "MIT",
  "author": "williamslay <williamslay.lsy@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williamslay/Zotero-FigureGuard.git"
  },
  "keywords": [
    "zotero",
    "zotero-plugin",
    "pdf",
    "dark-theme",
    "figure-detection"
  ],
  "scripts": {
    "test": "node scripts/run-tests.mjs all",
    "test:ci": "node scripts/run-tests.mjs ci",
    "test:fixture": "node scripts/run-tests.mjs all",
    "detect": "node --test tests/js/fixture-detect.test.mjs",
    "probe": "node scripts/probe_pdfjs_ops.mjs",
    "render": "node scripts/render_check.mjs",
    "build": "node scripts/build.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "esbuild": "^0.28.2",
    "pdfjs-dist": "^6.5.438"
  }
}
