# Build output: regenerated by `npm run build`
build/
dist/

# Generated detection dumps and development logs
# (tracked on the dev branch, ignored on the public main branch)
reports/

# Internal working documents
# (tracked on the dev branch, ignored on the public main branch).
# Only published developer docs in docs/ are tracked on main.
docs/*
!docs/RELEASING.md
!docs/DEVELOPMENT.md
!docs/KNOWN_ISSUES.md

# Copyrighted test papers and their reference renders: not redistributed
fixture/*.pdf
fixture/*.png
/*.pdf
/*.zip

node_modules/
__pycache__/
.pytest_cache/
