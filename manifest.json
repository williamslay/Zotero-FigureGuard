{
  "manifest_version": 2,
  "name": "Zotero Figure Guard",
  "version": "0.6.0",
  "description": "Keeps detected figure regions in their original PDF colours inside the dark Zotero reader.",
  "icons": {
    "16": "content/figureguard-icon.svg",
    "32": "content/figureguard-icon.svg",
    "48": "content/figureguard-icon.svg",
    "96": "content/figureguard-icon.svg"
  },
  "applications": {
    "zotero": {
      "id": "figure-guard@zotero.org",
      "update_url": "https://williamslay.github.io/Zotero-FigureGuard/updates.json",
      "strict_min_version": "6.999",
      "strict_max_version": "10.9.9"
    }
  }
}
